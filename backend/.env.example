SAKURAPLAYER_ENV=production-private
SAKURAPLAYER_LOG_LEVEL=INFO
SAKURAPLAYER_PUBLISH_HOST=127.0.0.1
SAKURAPLAYER_API_PORT=8000
SAKURAPLAYER_TRUST_PROXY_HEADERS=false
SAKURAPLAYER_SETTINGS_KEY_ID=v1

POSTGRES_DB=sakuraplayer
POSTGRES_USER=sakuraplayer

SAKURAPLAYER_POSTGRES_PASSWORD_SECRET_FILE=./secrets/postgres_password.txt
SAKURAPLAYER_SETTINGS_KEY_SECRET_FILE=./secrets/settings_key.txt
SAKURAPLAYER_TOKEN_KEY_SECRET_FILE=./secrets/token_key.txt
SAKURAPLAYER_PLAYBACK_KEY_SECRET_FILE=./secrets/playback_key.txt
SAKURAPLAYER_BOOTSTRAP_TOKEN_SECRET_FILE=./secrets/bootstrap_token.txt
